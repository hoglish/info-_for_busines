digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.45];
node [shape=box, style="rounded,filled", fontname="Noto Sans", fontsize=13, color="#2F5597", fillcolor="#EAF2F8", margin="0.18,0.1"];
edge [fontname="Noto Sans", fontsize=11, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить коллекцию продаж", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
v [label="Список null (или limit < 0, пустой region)?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
err [label="Выбросить IllegalArgumentException", fillcolor="#FFCCCC", color="#C00000"];
n2 [label="Сформировать stream (sales.stream())\nисходный список не изменяется"];
n3 [label="A1: Отфильтровать по условию метода:\namount >= min (topSales), region == region\n(averageByRegion), amount >= порога (largeSales)", fillcolor="#E8F5E9", color="#548235"];
n4 [label="Отсортировать Comparator (amount по убыванию,\nзатем id) или сгруппировать groupingBy(manager)\n(+ комиссия 20% — вариант 3)", fillcolor="#E8F5E9", color="#548235"];
n5 [label="Терминальная операция:\ntoList / min / average / collect"];
n6 [label="Результат найден?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n7 [label="Вернуть результат\n(List, Optional.of, Map, double)"];
n8 [label="Вернуть Optional.empty, пустой список,\nпустой Map или 0.0"];
start -> n1;
n1 -> v;
v -> err [label="да"];
v -> n2 [label="нет"];
n2 -> n3;
n3 -> n4;
n4 -> n5;
n5 -> n6;
n6 -> n7 [label="да"];
n6 -> n8 [label="нет"];
n7 -> end;
n8 -> end;
err -> end;
}
