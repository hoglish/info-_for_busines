digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.5];
node [shape=box, style="rounded,filled", fontname="Noto Sans", fontsize=13, color="#2F5597", fillcolor="#EAF2F8", margin="0.18,0.1"];
edge [fontname="Noto Sans", fontsize=11, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Открыть файл: Files.exists + Files.newBufferedReader\n(try-with-resources)", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
n2 [label="Файл доступен?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n10 [label="Выбросить IOException\n(импорт прекращён целиком, R7)", fillcolor="#FFCCCC", color="#C00000"];
h [label="Прочитать заголовок и пропустить (R1)"];
n3 [label="Читать следующую строку (lineNumber++)"];
n4 [label="Есть строка?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
sk [label="Строка пустая или комментарий (#)?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n5 [label="A1: Разобрать и проверить строку:\nsplit(\";\", -1), 4 поля (R2);\nИНН (R3), email (R4), website (вариант 26)", fillcolor="#E8F5E9", color="#548235"];
n6 [label="Строка корректна?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
dup [label="ИНН уже есть в репозитории? (R8)", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n7 [label="Сохранить Client в ClientRepository,\naccepted++"];
n8 [label="Записать ImportError:\nномер строки + причина (R5)", fillcolor="#FFE5CC", color="#C65911"];
n9 [label="A2: Сформировать ImportResult:\naccepted, rejected, errors", fillcolor="#E8F5E9", color="#548235"];
start -> n1;
n1 -> n2;
n2 -> h [label="да"];
n2 -> n10 [label="нет"];
h -> n3;
n3 -> n4;
n4 -> sk [label="да"];
n4 -> n9 [label="нет (конец файла)"];
sk -> n3 [label="да (пропуск)"];
sk -> n5 [label="нет"];
n5 -> n6;
n6 -> dup [label="да"];
n6 -> n8 [label="нет"];
dup -> n7 [label="нет"];
dup -> n8 [label="да"];
n7 -> n3 [label="back-edge (R6)"];
n8 -> n3 [label="back-edge (R6)"];
n9 -> end;
n10 -> end;
}
