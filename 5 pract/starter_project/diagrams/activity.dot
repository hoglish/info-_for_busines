digraph ActivityDiagram {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=lightblue];
    edge [color=black];
    
    start [shape=circle, label="Начало", fillcolor=green];
    n1 [label="Получить строку часов"];
    n2 [label="Разделить строку через split(\";\", -1)"];
    n3 [shape=diamond, label="Ровно 6 значений?"];
    n4 [label="Для каждого элемента:\nпроверить regex и диапазон [0, 16],\nпреобразовать в int"];
    n5 [shape=diamond, label="Все элементы корректны?"];
    n6 [label="Вычислить:\ntotal, average (2 знака),\novertimeDays, weeklyOvertime,\naddPayForWeek"];
    n7 [label="Сформировать строку:\nсумма, среднее, дни переработки,\nнедельная переработка, оплата"];
    n8 [label="Сформировать сообщение\nоб ошибке с позицией"];
    end [shape=doublecircle, label="Завершение", fillcolor=red];
    
    start -> n1;
    n1 -> n2;
    n2 -> n3;
    n3 -> n4 [label="да"];
    n3 -> n8 [label="нет"];
    n4 -> n5;
    n5 -> n6 [label="да"];
    n5 -> n8 [label="нет"];
    n6 -> n7;
    n7 -> end;
    n8 -> end;
}