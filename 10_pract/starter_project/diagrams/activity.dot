digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.45];
node [shape=box, style="rounded,filled", fontname="Noto Sans", fontsize=13, color="#2F5597", fillcolor="#EAF2F8", margin="0.18,0.1"];
edge [fontname="Noto Sans", fontsize=11, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить параметры доставки\n(тип, расстояние, вес, сумма заказа)", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
b0 [label="Вызван addLockerCost?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
b1 [label="Часть Б (вариант 26): подставить\nтип LOCKER, остальные поля сохранить", fillcolor="#E2F0D9", color="#548235"];
n2 [label="Определить тип доставки (req.type())"];
n3 [label="A1: Получить политику доставки через\nFactory по типу запроса (switch, без формул)\nSTANDARD / EXPRESS / PICKUP / LOCKER"];
n4 [label="Проверить возможность доставки\n(policy.supports(req))"];
n5 [label="Доставка возможна?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n6 [label="Вызвать policy.calculateCost(req)\nполиморфно (без if-else по типам)"];
n7 [label="Вернуть стоимость (double)"];
n8 [label="Выбросить IllegalArgumentException\n(\"Unsupported delivery\")", fillcolor="#FFCCCC", color="#C00000"];
start -> n1;
n1 -> b0;
b0 -> b1 [label="да"];
b0 -> n2 [label="нет"];
b1 -> n2;
n2 -> n3;
n3 -> n4;
n4 -> n5;
n5 -> n6 [label="да"];
n5 -> n8 [label="нет"];
n6 -> n7;
n7 -> end;
n8 -> end;
}
