digraph G {
    graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.35];
    node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
    edge [fontname="Times New Roman", fontsize=9, color="#555555"];
    
    start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
    end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
    
    n1 [label="Получить параметры заявки", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
    n_protect [label="Проверить контракты:\namount >= 0, risk != null", fillcolor="#FFF2CC", color="#BF9000"];
    
    // ВАРИАНТ 26: Новая проверка запрета
    n_v26 [label="V26: Urgent AND Personal?", shape=diamond, fillcolor="#F4CCCC", color="#C00000"];
    
    n2 [label="Есть персональные данные (R1)", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
    n3 [label="TODO A1: Проверить правила R2-R5\nпо приоритету (HIGH → Sum → Urgent → Std)", fillcolor="#F4CCCC", color="#C00000", style="rounded,dashed,filled"];
    n7 [label="Вернуть маршрут согласования"];
    n8 [label="Выбросить IllegalArgumentException", fillcolor="#FFCCCC", color="#C00000"];
    
    start -> n1;
    n1 -> n_protect;
    n_protect -> n_v26 [label="OK"];
    n_protect -> n8 [label="Ошибка контракта"];
    
    // ВАРИАНТ 26: Ветка запрета
    n_v26 -> n8 [label="да (ЗАПРЕЩЕНО)"];
    n_v26 -> n2 [label="нет"];
    
    n2 -> n7 [label="да → SECURITY_REVIEW"];
    n2 -> n3 [label="нет"];
    n3 -> n7 [label="маршрут найден"];
    n3 -> n8 [label="ошибка"];
    n7 -> end;
    n8 -> end;
}